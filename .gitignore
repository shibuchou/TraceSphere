# Local environment and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependencies and generated build output
**/node_modules/
**/.npm-cache/
**/dist/
**/dist-ssr/
**/build/
coverage/

# Python caches and environments
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
*.py[cod]

# Local editor state, logs and backups
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.bak
*.orig

# Local-only credential copies of the demo script (never pushed)
**/*.local.md

# Internal handover / submission-prep documents (kept locally, not pushed)
docs/开工交接-*.md
docs/交接文档-*.md
docs/demo-*.md
docs/fixlog-*.md
docs/anonymization-sweep-*.md
deploy/README.md

# Local deliverable drafts (PDFs generated from local paths)
docs/成品文档/

# Ad-hoc local backups created next to the repo
.*-backup-*

# Local sanitizer rules (contain internal identifiers, never committed)
tools/sanitize-rules.local

# Local browser-automation artifacts (may contain live resource ids)
.playwright-cli/
