# ============================================================
# TraceSphere Web Console 环境变量示例
#   Linux/macOS:  cp .env.example .env.local   然后按需修改
#   Windows:      copy .env.example .env.local
# ============================================================

# -------- 数据源模式（P0 降级/回放开关，方案 §2.1）--------
# api     = 请求真实诊断服务（默认，API.md §4 契约）
# fixture = 读取本地 src/mocks/*.json，结构与 API 完全一致，无需后端即可完整演示
VITE_DATA_SOURCE=api

# -------- 诊断服务地址（仅 api 模式使用）--------
# 留空 = 使用相对路径 /api/v1，由 dev server（vite.config.mjs 的 proxy）
#        或生产 nginx 反向代理到 rca-serve，前端同源、零 CORS 依赖（推荐）。
# 填绝对地址 = 直连诊断服务，例如 http://127.0.0.1:8010
VITE_RCA_BASE_URL=

# Vite dev server 的反向代理目标（rca-serve 监听地址）
VITE_API_PROXY_TARGET=http://127.0.0.1:8010

# -------- 平台层地址（页脚展示用，可选）--------
VITE_PLATFORM_BASE_URL=http://127.0.0.1:8000

# -------- 默认演示场景（顶栏「演示路径」的初始选中项）--------
# case1-oom | case2-cpu | case3-tool-failure
VITE_DEFAULT_SCENARIO=case1-oom

# -------- 顶栏环境标识 --------
VITE_ENV_LABEL=ZSvirt 智算云 · 演示环境
