# 复制为同目录 .env 后按环境填写（docker compose 自动读取）
# 平台事件接收地址（业务 VM 可达；留空则 agent-service / mock-dcgm 只打 stdout）
PLATFORM_EVENTS_URL=http://<平台 IP>:8000/api/v1/events
# workload-vm 在 ZSvirt 中的 uuid（Agent 注册 + VM->Container 归属）
TRACESPHERE_VM_UUID=<ZSvirt VM uuid>
# 模拟 GPU 资源 ID（无 GPU 硬件的降级模式；需与平台 TRACESPHERE_MOCK_GPU_UUID 一致）
TRACESPHERE_GPU_RESOURCE_ID=gpu:mock-gpu0

# ---- 安全基线（推荐全部配置）----
# 平台 API Token（与 platform 的 TRACESPHERE_API_TOKEN 一致；直报/注册会带 Bearer）
PLATFORM_TOKEN=<平台 API Token>
# Agent 任务接口令牌（可选；设置后需用 TASK_TOKEN=<同值> bash faults/run-task.sh）
# TASK_TOKEN=
# 端口绑定：控制面仅回环；Prometheus 需要平台跨机读取时设 PROM_BIND=<业务 VM IP>
BIND_ADDR=127.0.0.1
PROM_BIND=127.0.0.1
